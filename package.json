{
  "name": "dsh-pixiv-aesthetic",
  "version": "0.1.0",
  "description": "DSH 插件：按你的口味刷 Pixiv —— 搜、筛、看图精选，存到本地或发给你。网络在直连/代理/外部源之间自动选路。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pixiv",
    "illustration",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "//build": "本插件零运行时依赖、无编译步骤（纯 Node 内置模块）。但 git 直装时 DSH 会执行 `pnpm install` + `pnpm run build` 准备 checkout，所以这里给出一个显式的空 build（外加自检），免得因为「没有 build 脚本」被判定为准备失败。",
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "selfcheck": "node selfcheck.mjs",
    "selfcheck:all": "node selfcheck.mjs && node selfcheck-taste.mjs && node selfcheck-auth.mjs && node selfcheck-external.mjs && node selfcheck-tools.mjs && node selfcheck-io.mjs && node selfcheck-host.mjs && node selfcheck-client.mjs && node selfcheck-docs.mjs && node selfcheck-shell.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "selfcheck.mjs",
    "selfcheck-io.mjs",
    "selfcheck-tools.mjs",
    "selfcheck-host.mjs",
    "selfcheck-auth.mjs",
    "selfcheck-client.mjs",
    "selfcheck-docs.mjs",
    "selfcheck-external.mjs",
    "selfcheck-shell.mjs",
    "selfcheck-proxy.mjs",
    "selfcheck-taste.mjs",
    "selfcheck-feedback.mjs",
    "selfcheck-explore.mjs",
    "selfcheck-bookmarks.mjs"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      },
      "note": "纯 host + web client 插件，零运行时依赖（只用 Node 内置模块）。"
    }
  }
}
